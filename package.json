{
  "name": "instantgram-monorepo",
  "private": true,
  "packageManager": "pnpm@11.28.5+sha512.484563d30b4c2ad27cb48aa94ff2b302dbcebc8ff6bf28816c2589886e146ce7f76f354f3bc1a438e6f5e9768c302aa0a6f7add8232903cd4cf81426cbc14d9e",
  "scripts": {
    "build": "pnpm run build:all",
    "build:all": "pnpm --filter @instantgram/bookmarklet build:release && pnpm --filter @instantgram/bookmarklet size && pnpm --filter @instantgram/site build",
    "build:release": "pnpm run build:all",
    "build:bookmarklet": "pnpm --filter @instantgram/bookmarklet build",
    "build:site": "pnpm --filter @instantgram/site build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test"
  },
  "devDependencies": {
    "turbo": "^2.11.7"
  }
}
