{
  "name": "instantgram",
  "version": "2026.05.20",
  "description": "A bookmarklet for download photos in Instagram",
  "homepage": "https://saschaheim.github.io/instantgram/",
  "repository": {
    "type": "git",
    "url": "https://github.com/saschaheim/instantgram"
  },
  "license": "ISC",
  "author": "Sascha Heim",
  "type": "commonjs",
  "main": "src/index.js",
  "scripts": {
    "build": "npm run build:clean && npm run build:rollup && npm run build:release",
    "build:clean": "powershell -Command \"if (Test-Path dist) { Get-ChildItem -Path dist -Filter *.map -File -ErrorAction SilentlyContinue | Remove-Item -Force -ErrorAction SilentlyContinue }\"",
    "build:bookmarklet": "node scripts/bookmarkletify.js",
    "build:bookmarklet:dev": "node scripts/bookmarkletify.js --dev",
    "build:pages": "node \"src/_langs/metalsmith.js\"",
    "build:release": "npm run build:bookmarklet && npm run build:pages",
    "build:release:dev": "npm run build:bookmarklet:dev && npm run build:pages",
    "build:rollup": "rollup -c",
    "dev": "concurrently \"npm run dev:rollup\" \"npm run dev:watch\"",
    "dev:rollup": "rollup -c -w",
    "dev:watch": "nodemon --watch dist/main.js --exec \"npm run build:release:dev\"",
    "lint": "eslint **/*.ts",
    "start": "npm run dev"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@metalsmith/layouts": "^2.7.0",
    "@metalsmith/markdown": "^1.10.0",
    "@metalsmith/permalinks": "^3.2.0",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@swc/core": "^1.15.33",
    "@types/node": "^24.10.0",
    "concurrently": "^9.2.1",
    "cssnano": "^7.1.9",
    "globals": "^17.6.0",
    "handlebars": "^4.7.9",
    "eslint": "^10.0.0",
    "jstransformer-handlebars": "^1.2.0",
    "metalsmith": "^2.7.0",
    "metalsmith-define": "^2.1.3",
    "metalsmith-discover-partials": "^0.1.2",
    "nodemon": "^3.1.14",
    "rollup": "^4.60.4",
    "rollup-plugin-analyzer": "^4.0.0",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-sourcemaps": "^0.6.3",
    "rollup-plugin-swc3": "^0.12.1",
    "signale": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4",
    "uglify-js": "^3.19.3"
  },
  "dependencies": {
    "util": "^0.12.5"
  }
}
