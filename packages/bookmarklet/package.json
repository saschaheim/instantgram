{
  "name": "@instantgram/bookmarklet",
  "version": "2026.07.25",
  "description": "A bookmarklet for download photos in Instagram",
  "homepage": "https://saschaheim.github.io/instantgram/",
  "repository": {
    "type": "git",
    "url": "https://github.com/saschaheim/instantgram"
  },
  "license": "ISC",
  "author": "Sascha Heim",
  "type": "commonjs",
  "main": "src/index.js",
  "scripts": {
    "build": "node scripts/build-localized-bundles.js && node scripts/bookmarkletify.js",
    "build:bundles": "node scripts/build-localized-bundles.js",
    "build:bookmarklet": "node scripts/bookmarkletify.js",
    "build:bookmarklet:dev": "node scripts/bookmarkletify.js --dev",
    "dev": "nodemon --watch src --watch scripts --watch package.json --watch rollup.config.js --watch ../site/src/data --ext ts,js,json --exec \"pnpm run build\"",
    "lint": "eslint src/**/*.ts tests/**/*.ts",
    "test": "vitest run --config vitest.config.ts",
    "size": "node scripts/size-bookmarklets.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@swc/core": "^1.15.33",
    "@types/node": "^26.1.1",
    "cssnano": "^7.1.9",
    "eslint": "^10.0.0",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "nodemon": "^3.1.14",
    "rollup": "^4.60.4",
    "rollup-plugin-analyzer": "^4.0.0",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-swc3": "^0.12.1",
    "signale": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4",
    "uglify-js": "^3.19.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "tslib": "2.8.1",
    "util": "^0.12.5"
  }
}
