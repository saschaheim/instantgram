# EditorConfig is awesome: https://editorconfig.org

# top-most EditorConfig file
root = true

# Windows-style newlines with a newline ending every file
[*]
end_of_line = crlf
insert_final_newline = true

[*.js]
charset = utf-8
indent_style = space
indent_size = 2

[*.ts]
charset = utf-8
indent_style = space
indent_size = 2