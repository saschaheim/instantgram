---
interface LanguageLink {
  lang: string;
  langIso: string;
  name: string;
  href: string;
  alternateHref?: string;
}

interface Props {
  locale: string;
  localeIso: string;
  pageTitle: string;
  projectLead: string;
  projectButtonHelper: string;
  projectDescription: string;
  bookmarkletHtml: string;
  version: string;
  languageLinks: LanguageLink[];
  assetBase: string;
  homeHref: string;
}

const {
  locale,
  localeIso,
  pageTitle,
  projectLead,
  projectButtonHelper,
  projectDescription,
  bookmarkletHtml,
  version,
  languageLinks,
  assetBase,
  homeHref,
} = Astro.props;
const joinAsset = (relativePath: string) => `${assetBase}/${relativePath}`.replace(/^\.\/+/, "").replace(/\/{2,}/g, "/");
const stylesheetHref = `${joinAsset("stylesheets/stylesheet.css")}?v=${version}`;
---
<!DOCTYPE html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    {languageLinks.map((entry) => <link rel="alternate" href={entry.alternateHref ?? entry.href} hreflang={entry.langIso} />)}
    <link rel="alternate" href={languageLinks[0]?.alternateHref ?? languageLinks[0]?.href} hreflang="x-default" />
    <title>[instantgram] - {pageTitle}</title>
    <meta name="description" content={pageTitle} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="google-site-verification" content="BbRUNLVG70a_9r_nJTAUNwYff6-MSky-lkjCTc2gwII" />
    <link rel="stylesheet" type="text/css" href={joinAsset("stylesheets/normalize.css")} media="screen" />
    <link href="https://fonts.googleapis.com/css?family=Open+Sans:400,700" rel="stylesheet" type="text/css" />
    <link rel="stylesheet" type="text/css" href={stylesheetHref} media="screen" />
    <link rel="stylesheet" type="text/css" href={joinAsset("stylesheets/github-light.css")} media="screen" />
    <link rel="apple-touch-icon" sizes="152x152" href={joinAsset("img/apple-touch-icon-152x152-precomposed.png")} />
    <link rel="apple-touch-icon" sizes="144x144" href={joinAsset("img/apple-touch-icon-144x144-precomposed.png")} />
    <link rel="apple-touch-icon" sizes="120x120" href={joinAsset("img/apple-touch-icon-120x120-precomposed.png")} />
    <link rel="apple-touch-icon" sizes="114x114" href={joinAsset("img/apple-touch-icon-114x114-precomposed.png")} />
    <link rel="apple-touch-icon" sizes="76x76" href={joinAsset("img/apple-touch-icon-76x76-precomposed.png")} />
    <link rel="apple-touch-icon" sizes="72x72" href={joinAsset("img/apple-touch-icon-72x72-precomposed.png")} />
    <link rel="apple-touch-icon" sizes="60x60" href={joinAsset("img/apple-touch-icon-60x60-precomposed.png")} />
    <link rel="apple-touch-icon" sizes="57x57" href={joinAsset("img/apple-touch-icon-57x57-precomposed.png")} />
    <link rel="shortcut icon" href={joinAsset("img/favicon.ico")} />
    <style>
      .github-corner:hover .octo-arm {
        animation: octocat-wave 560ms ease-in-out;
      }

      @keyframes octocat-wave {
        0%,
        100% {
          transform: rotate(0);
        }

        20%,
        60% {
          transform: rotate(-25deg);
        }

        40%,
        80% {
          transform: rotate(10deg);
        }
      }

      .language-bar {
        position: absolute;
        top: 0;
        left: 25px;
        text-align: center;
        font-size: 12px;
        font-size: 0.9vmax;
      }

      .language-bar a {
        color: #fff;
      }

      @media (max-width: 500px) {
        .github-corner:hover .octo-arm {
          animation: none;
        }

        .github-corner .octo-arm {
          animation: octocat-wave 560ms ease-in-out;
        }
      }
    </style>
  </head>
  <body>
    <a href="https://github.com/saschaheim/instantgram" class="github-corner">
      <svg width="80" height="80" viewBox="0 0 250 250" style="fill:#151513;color:#fff;position:absolute;top:0;border:0;right:0;">
        <path d="M0,0 L115,115 L130,115 L142,142 L250,250 L250,0 Z"></path>
        <path
          d="M128.3,109.0 C113.8,99.7 119.0,89.6 119.0,89.6 C122.0,82.7 120.5,78.6 120.5,78.6 C119.2,72.0 123.4,76.3 123.4,76.3 C127.3,80.9 125.5,87.3 125.5,87.3 C122.9,97.6 130.6,101.9 134.4,103.2"
          fill="currentColor"
          style="transform-origin:130px 106px"
          class="octo-arm"
        ></path>
        <path
          d="M115.0,115.0 C114.9,115.1 118.7,116.5 119.8,115.4 L133.7,101.6 C136.9,99.2 139.9,98.4 142.2,98.6 C133.8,88.0 127.5,74.4 143.8,58.0 C148.5,53.4 154.0,51.2 159.7,51.0 C160.3,49.4 163.2,43.6 171.4,40.1 C171.4,40.1 176.1,42.5 178.8,56.2 C183.1,58.6 187.2,61.8 190.9,65.4 C194.5,69.0 197.7,73.2 200.1,77.6 C213.8,80.2 216.3,84.9 216.3,84.9 C212.7,93.1 206.9,96.0 205.4,96.6 C205.1,102.4 203.0,107.8 198.3,112.5 C181.9,128.9 168.3,122.5 157.7,114.1 C157.9,116.9 156.7,120.9 152.7,124.9 L141.0,136.5 C139.8,137.7 141.6,141.9 141.8,141.8 Z"
          fill="currentColor"
          class="octo-body"
        ></path>
      </svg>
    </a>

    <section class="page-header">
      <div class="language-bar">
        <p>
          {
            languageLinks.map((entry, index) => (
              <>
                <a data-lang={entry.lang} href={`${entry.href}?force=true`}>
                  <span style={entry.lang === locale ? "text-decoration:underline" : undefined}>{entry.name}</span>
                </a>
                {index < languageLinks.length - 1 ? " |" : null}
              </>
            ))
          }
        </p>
      </div>
      <h1 class="project-name">Instantgram</h1>
      <h2 class="project-tagline">{projectLead}</h2>
      <Fragment set:html={bookmarkletHtml} />
      <br />
      <small>{projectButtonHelper}</small>
    </section>

    <section class="main-content">
      <h1>
        <a id="instantgram" class="anchor" href="#instantgram" aria-hidden="true">
          <span class="octicon octicon-link"></span>
        </a>
        <a href={homeHref}>[instantgram]</a>
      </h1>
      <p>
        <img src={`https://img.shields.io/badge/version-${version}-green.svg?style=flat-square`} alt="version" />
        <img src="https://img.shields.io/badge/for-instagram-yellow.svg?style=flat-square" alt="badge" />
      </p>
      <p>{projectDescription}</p>
      <img src={joinAsset("img/demo.gif")} style="width:auto;max-width:95%;display:block;margin:0 auto;" />
      <footer class="site-footer">
        <span class="site-footer-owner">
          <a href="https://github.com/saschaheim/instantgram">instantgram</a> is maintained by
          <a href="https://github.com/saschaheim"> Sascha Heim</a>.
        </span>
        <span class="site-footer-credits">
          This page is generated with <a href="https://astro.build">Astro</a> and published on
          <a href="https://pages.github.com"> GitHub Pages</a>.
        </span>
      </footer>
    </section>

    <script async src="https://www.googletagmanager.com/gtag/js?id=UA-64893820-4"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        window.dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "UA-64893820-4");
    </script>
    <script is:inline define:vars={{ locale, localeIso }}>
      function getQueryStringParam(key) {
        return new URLSearchParams(window.location.search).get(key);
      }

      function hostedHref(lang) {
        switch (lang) {
          case "de-DE":
            return "/instantgram/lang/de-de/";
          case "pt-BR":
            return "/instantgram/lang/pt-br/";
          case "es-AR":
            return "/instantgram/lang/es-ar/";
          default:
            return "/instantgram/";
        }
      }

      const language = (navigator.languages && navigator.languages[0]) || navigator.language || navigator.userLanguage;
      if (window.location.protocol !== "file:" && !getQueryStringParam("force") && typeof language !== "undefined") {
        const localePrefix = localeIso.toLowerCase();
        const pathname = window.location.pathname.toLowerCase();
        const isCurrentLocale = localePrefix === "en" ? pathname === "/instantgram/" || pathname === "/instantgram/index.html" : pathname.includes(`/lang/${localePrefix}`);

        if (!isCurrentLocale) {
          switch (language.substring(0, 2)) {
            case "de":
              window.location.href = hostedHref("de-DE");
              break;
            case "pt":
              window.location.href = hostedHref("pt-BR");
              break;
            case "es":
              window.location.href = hostedHref("es-AR");
              break;
            default:
              window.location.href = hostedHref("en-US") + "?force=true";
          }
        }
      }
    </script>
  </body>
</html>
