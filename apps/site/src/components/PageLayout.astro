---
interface LanguageLink {
  lang: string;
  name: string;
  href: string;
}

interface Props {
  locale: string;
  localeIso: string;
  pageTitle: string;
  projectLead: string;
  projectButtonHelper: string;
  projectDescription: string;
  bookmarkletHtml: string;
  firefoxBookmarkletHtml: string;
  version: string;
  languageLinks: LanguageLink[];
  assetBase: string;
  homeHref: string;
}

const {
  locale,
  localeIso,
  pageTitle,
  projectLead,
  projectButtonHelper,
  projectDescription,
  bookmarkletHtml,
  firefoxBookmarkletHtml,
  version,
  languageLinks,
  assetBase,
  homeHref
} = Astro.props;

